# Postgres connection. For Vercel deployment, use Supabase's CONNECTION
# POOLER url (port 6543) + ?pgbouncer=true instead — see README.
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string

# Gmail sender for welcome/reset/activation emails — use a 16-character
# App Password (myaccount.google.com/apppasswords), not your real password
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=Owuja <heyowuja@owuja.com>
EMAIL_REPLY_TO=support@owuja.com
EMAIL_ADMIN=admin@owuja.com

# Comma-separated existing Owuja account emails allowed to manage the platform waitlist
PLATFORM_ADMIN_EMAILS=admin@owuja.com
WAITLIST_PUBLIC_URL=https://owuja.com
WAITLIST_INVITE_URL=https://owuja.com/download

# Deep links opened by email links
APP_DEEP_LINK_BASE=thefashionhouse://reset-password
APP_DEEP_LINK_BASE_ACTIVATE=thefashionhouse://activate

# Gemini API key from aistudio.google.com/apikey — separate from any
# personal Gemini Pro subscription, billed independently per token
GEMINI_API_KEY=your-gemini-api-key-here

PORT=4000
# Number of trusted reverse-proxy hops. Use 0 for a direct connection.
TRUST_PROXY_HOPS=0
# On Railway only, trust its edge-provided X-Real-IP (keep hop count at 0).
TRUST_RAILWAY_PROXY=false
# Same private random value on web and backend; at least 32 characters.
# WEB_PROXY_SECRET=
# Development defaults to memory. Production requires database after migrations.
RATE_LIMIT_STORE=memory
ALLOWED_ORIGIN=*
NODE_ENV=development

# Enable only after installing and testing the database row policies.
# DATABASE_URL must then use the restricted runtime login, not the owner.
DATABASE_RLS_ENABLED=false
# Private owner connection used only by authentication/platform operations.
# IDENTITY_DATABASE_URL="postgresql://owner:password@your-host/database?sslmode=verify-full"
# DIRECT_URL remains the owner connection used for schema migrations.

# Cloudflare R2 / S3 configuration
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_BUCKET_NAME=your-bucket-name
R2_PUBLIC_URL=https://your-public-bucket-url.com
