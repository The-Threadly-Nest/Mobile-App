{
  "name": "owuja-server",
  "version": "1.0.0",
  "main": "dist/src/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "prebuild": "prisma generate",
    "build": "tsc",
    "vercel-build": "prisma generate",
    "start": "node dist/src/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:provision": "node deployment/provision-runtime.mjs",
    "seed:dev": "node deployment/dev-seed.cjs",
    "test:dev-users": "node deployment/test-dev-users.cjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "email:test": "node scripts/send-test-emails.mjs",
    "typecheck": "tsc --noEmit --incremental false"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "@aws-sdk/client-s3": "^3.1112.0",
    "@aws-sdk/s3-request-presigner": "^3.1112.0",
    "@google/generative-ai": "^0.14.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@types/multer": "^2.2.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "express-rate-limit": "^7.2.0",
    "google-auth-library": "^11.3.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.5.0",
    "pg": "^8.23.0",
    "sharp": "^0.35.5",
    "swagger-ui-express": "^5.0.1",
    "tsconfig-paths": "^4.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.12",
    "@types/pg": "^8.23.1",
    "@types/swagger-ui-express": "^4.1.8",
    "prisma": "^7.9.1",
    "tsx": "^4.10.0",
    "typescript": "^5.4.5"
  },
  "overrides": {
    "ajv": "^8.20.0",
    "js-yaml": "^4.3.1",
    "minimatch": "^10.2.6",
    "multer": "$multer",
    "smol-toml": "^1.8.0",
    "undici": "^6.28.0"
  },
  "private": true,
  "engines": { "node": ">=20.9.0" }
}
