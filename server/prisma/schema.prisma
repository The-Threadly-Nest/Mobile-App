// The Threadly Nest — full schema. Auth is fully custom (Express-owned):
// email + password with bcrypt hashing. No Supabase, no OTP.

generator client {
  provider      = "prisma-client"
  output        = "../src/generated/prisma"
  moduleFormat  = "cjs"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  googleId            String?   @unique
  passwordHash        String?   // null until a Staff account is activated
  name                String?   // display name, set at signup or from Google profile
  role                String    // admin | staff | customer
  fashionHouseId      String?   // set for staff; null for admin (owns via FashionHouse.adminId) and customer
  active              Boolean   @default(true) // false for Staff pending activation
  resetTokenHash      String?
  resetTokenExpiresAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  fashionHouseOwned FashionHouse?   @relation("FashionHouseAdmin")
  fashionHouse      FashionHouse?   @relation("FashionHouseStaff", fields: [fashionHouseId], references: [id])
  delegatedOrders   Order[]         @relation("StaffOrders")
  bookings          Booking[]
  chatEscalations   ChatEscalation[]
  chatSessions      ChatSession[]   @relation("CustomerChatSessions")
  preference        CustomerPreference?
  moodBoardSketches MoodBoardSketch[] @relation("StaffMoodBoardSketches")

  @@index([fashionHouseId])
  @@map("users")
}

model FashionHouse {
  id                  String   @id @default(uuid())
  adminId             String   @unique
  shopName            String
  location            String?
  phone               String?
  bio                 String?
  brandLogoUrl        String?
  categories          String[] @default([])
  currency            String   @default("NGN")
  onboardingCompleted Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  admin           User             @relation("FashionHouseAdmin", fields: [adminId], references: [id], onDelete: Cascade)
  staff           User[]           @relation("FashionHouseStaff")
  customers       Customer[]
  catalogItems    CatalogItem[]
  orders          Order[]
  availableSlots  AvailableSlot[]
  bookings        Booking[]
  chatEscalations ChatEscalation[]
  chatSessions    ChatSession[]
  sketches        Sketch[]

  @@map("fashion_houses")
}

model Customer {
  id             String   @id @default(uuid())
  fashionHouseId String
  name           String
  phone          String?
  sheetUrl       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  fashionHouse FashionHouse  @relation(fields: [fashionHouseId], references: [id], onDelete: Cascade)
  measurements Measurement[]
  orders       Order[]

  @@index([fashionHouseId])
  @@map("customers")
}

model Measurement {
  id         String   @id @default(uuid())
  customerId String
  field      String
  value      Float
  unit       String   @default("in")
  recordedAt DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("measurements")
}

model Order {
  id             String   @id @default(uuid())
  fashionHouseId String
  customerId     String
  staffId        String?
  itemName       String
  price          Int
  status         String   @default("order_placed") // order_placed | in_production | ready | delivered
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  fashionHouse FashionHouse @relation(fields: [fashionHouseId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  staff        User?        @relation("StaffOrders", fields: [staffId], references: [id])
  invoice      Invoice?

  @@index([fashionHouseId])
  @@index([staffId])
  @@map("orders")
}

model Invoice {
  id        String   @id @default(uuid())
  orderId   String   @unique
  total     Int
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("invoices")
}

model CatalogItem {
  id             String   @id @default(uuid())
  fashionHouseId String
  name           String
  priceFrom      Int
  imageUrl       String
  createdAt      DateTime @default(now())

  fashionHouse FashionHouse @relation(fields: [fashionHouseId], references: [id], onDelete: Cascade)

  @@index([fashionHouseId])
  @@map("catalog_items")
}

model AvailableSlot {
  id             String   @id @default(uuid())
  fashionHouseId String
  date           String
  time           String
  booked         Boolean  @default(false)
  createdAt      DateTime @default(now())

  fashionHouse FashionHouse @relation(fields: [fashionHouseId], references: [id], onDelete: Cascade)

  @@index([fashionHouseId, booked])
  @@map("available_slots")
}

model Booking {
  id             String   @id @default(uuid())
  fashionHouseId String
  customerId     String
  styleNotes     String
  preferredDate  DateTime
  preferredTime  String
  status         String   @default("pending_admin_review")
  createdAt      DateTime @default(now())

  fashionHouse FashionHouse @relation(fields: [fashionHouseId], references: [id], onDelete: Cascade)
  customer     User         @relation(fields: [customerId], references: [id])

  @@index([fashionHouseId, status])
  @@map("bookings")
}

model ChatEscalation {
  id             String   @id @default(uuid())
  fashionHouseId String
  customerId     String
  reason         String
  summary        String
  transcript     String   @db.Text
  resolved       Boolean  @default(false)
  createdAt      DateTime @default(now())

  fashionHouse FashionHouse @relation(fields: [fashionHouseId], references: [id], onDelete: Cascade)
  customer     User         @relation(fields: [customerId], references: [id])

  @@index([fashionHouseId, resolved])
  @@map("chat_escalations")
}

model Sketch {
  id             String   @id @default(uuid())
  fashionHouseId String
  title          String
  imageUrl       String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  fashionHouse   FashionHouse @relation(fields: [fashionHouseId], references: [id], onDelete: Cascade)

  @@index([fashionHouseId])
  @@map("sketches")
}

model CustomerPreference {
  id        String   @id @default(uuid())
  userId    String   @unique
  styles    String[]
  budget    String
  timeline  String
  phone     String?
  location  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("customer_preferences")
}

model MoodBoardSketch {
  id                String   @id @default(uuid())
  staffId           String
  imageUrl          String
  title             String
  promotedToCatalog Boolean  @default(false)
  createdAt         DateTime @default(now())

  staff User @relation("StaffMoodBoardSketches", fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
  @@map("mood_board_sketches")
}

model ChatSession {
  id             String   @id @default(uuid())
  customerId     String
  fashionHouseId String
  history        Json     @default("[]")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  customer     User         @relation("CustomerChatSessions", fields: [customerId], references: [id], onDelete: Cascade)
  fashionHouse FashionHouse @relation(fields: [fashionHouseId], references: [id], onDelete: Cascade)

  @@unique([customerId, fashionHouseId])
  @@index([customerId])
  @@map("chat_sessions")
}
